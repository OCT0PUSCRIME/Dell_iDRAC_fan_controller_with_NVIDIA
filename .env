# ------------------------------------------------------------------------------
# Dell iDRAC Fan Controller - Tiered Configuration (.env example)
# ------------------------------------------------------------------------------
#
# NOTES:
# - These are STARTING POINT values. You MUST monitor your system and adjust
#   these based on your specific hardware, ambient temperatures, and noise tolerance.
# - The Enterprise GPUs are typically passively cooled and the most critical component to watch.
#   Ensure it receives adequate airflow under load.
# - If IDRAC_HOST is "local", USERNAME and PASSWORD are not used by the script.
#
# ------------------------------------------------------------------------------
# iDRAC Connection Settings
# ------------------------------------------------------------------------------
IDRAC_HOST=local # Replace with your iDRAC IP if not running script on the host itself
IDRAC_USERNAME=your_idrac_username # Only needed if IDRAC_HOST is an IP
IDRAC_PASSWORD=your_idrac_password # Only needed if IDRAC_HOST is an IP

# ------------------------------------------------------------------------------
# Temperature Thresholds (Celsius)
# ------------------------------------------------------------------------------
# If a component's temperature EXCEEDS the TIER X threshold,
# the script will consider moving to TIER X+1 fan speed.
# If a component's temperature EXCEEDS the TIER 4 threshold,
# the script will revert to Dell's default dynamic fan control for safety.

CPU_TEMP_THRESHOLD_TIER1=50
CPU_TEMP_THRESHOLD_TIER2=60
CPU_TEMP_THRESHOLD_TIER3=70
CPU_TEMP_THRESHOLD_TIER4=78

GPU_TEMP_THRESHOLD_TIER1=48
GPU_TEMP_THRESHOLD_TIER2=58
GPU_TEMP_THRESHOLD_TIER3=68
GPU_TEMP_THRESHOLD_TIER4=76

# ------------------------------------------------------------------------------
# Fan Speed Percentages (%) for Tiers
# ------------------------------------------------------------------------------
FAN_SPEED_TIER1=12
FAN_SPEED_TIER2=22
FAN_SPEED_TIER3=38
FAN_SPEED_TIER4=55

# ------------------------------------------------------------------------------
# Script Operation Settings
# ------------------------------------------------------------------------------
CHECK_INTERVAL=10
HYSTERESIS_TEMP=2

# Optional: Set to true to bypass the Dell server model check if 'ipmitool fru' fails.
# FORCE_DELL_CHECK_SKIP=false

# Script Logging Verbosity:
# "normal": Prints full status table periodically.
# "quiet": Suppresses periodic table, only logs critical events, errors, and fan changes.
SCRIPT_VERBOSITY=quiet